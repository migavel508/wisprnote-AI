# Supabase project URL (same as VITE_SUPABASE_URL in your .env.local)
SUPABASE_URL=https://your-project.supabase.co

# Supabase SERVICE ROLE key — find this in Supabase Dashboard > Settings > API
# This bypasses RLS so the server can query data for the configured user.
# Never expose this key in the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Your Supabase user UUID — find this in Supabase Dashboard > Authentication > Users
# All MCP queries will be scoped to this user's data only.
WISPRNOTE_USER_ID=your-user-uuid-here
