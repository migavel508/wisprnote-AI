{
  "name": "wisprnote-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:pg-native",
    "deploy": "npm run build && cd dist && zip -j function.zip index.js && aws lambda update-function-code --function-name wisprnote-api --zip-file fileb://function.zip --profile wisprnote --region us-east-1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.1056.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "aws-jwt-verify": "^5.1.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
