# ─────────────────────────────────────────────────────────────────────────────
# Wisprnote — example environment
#
# Copy to `.env.local` and fill in your own values:
#     cp .env.example .env.local
#
# `.env*` is gitignored (except this file). NEVER commit real credentials.
# Every value below is a placeholder — none of them are live keys.
#
# Anything prefixed VITE_ is inlined into the client bundle by Vite and is
# therefore VISIBLE TO ANYONE who runs the app. Only put publishable values in
# VITE_ vars. Server-only secrets belong in the backend's own environment
# (see aws/api) — not here.
# ─────────────────────────────────────────────────────────────────────────────

# ─── AI provider ─────────────────────────────────────────────────────────────
# "gemini"     → call Google's Gemini API directly
# "openrouter" → route model calls through OpenRouter
VITE_AI_PROVIDER=openrouter

# Gemini API key — required when VITE_AI_PROVIDER=gemini
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — required when VITE_AI_PROVIDER=openrouter. https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
# Embedding model. Must match the vector dimension of your Turbopuffer namespace.
VITE_OPENROUTER_EMBED_MODEL=google/gemini-embedding-001

# ─── Transcription ───────────────────────────────────────────────────────────
# Soniox is the current meeting-transcription provider. These are read by the
# backend / Rust helper, NOT by the browser bundle. https://soniox.com
SONIOX_API_KEY=
SONIOX_MODEL=
SONIOX_WS_URL=

# Deepgram — legacy real-time path, optional. https://console.deepgram.com
DEEPGRAM_API_KEY=
VITE_DEEPGRAM_API_KEY=

# ─── Vector search (RAG) ─────────────────────────────────────────────────────
# Turbopuffer powers hybrid retrieval over meeting chunks. https://turbopuffer.com
VITE_TURBOPUFFER_API_KEY=

# ─── AWS: auth + API + storage ───────────────────────────────────────────────
# Create these in your OWN AWS account — see docs/INSTALL.md.
VITE_AWS_REGION=us-east-1

# Cognito user pool that fronts sign-in.
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# Use a PUBLIC app client with NO client secret.
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=your-pool-domain
# Hosted UI origin. The regional domain works immediately, with no DNS setup:
#   https://<your-pool-domain>.auth.<region>.amazoncognito.com
# A custom domain (https://auth.example.com) needs public DNS to resolve first.
VITE_COGNITO_AUTH_ORIGIN=

# Optional — only if your federated IdP is not named exactly "Google"/"Microsoft".
# VITE_COGNITO_IDENTITY_PROVIDER=Google
# VITE_COGNITO_MICROSOFT_IDENTITY_PROVIDER=Microsoft

# ⚠️  LEGACY, LEAVE EMPTY. Only for a Cognito app client created WITH a secret.
# A value here is compiled into the shipped client bundle and is readable by
# every user, which defeats the purpose of a secret. Use a public app client.
# VITE_COGNITO_CLIENT_SECRET=

# OAuth redirect. Must match Cognito → App client → Hosted UI → callback URLs
# character-for-character (no trailing slash, same host your users visit).
# Leave empty in development so the app uses window.location.origin.
# VITE_WEB_OAUTH_REDIRECT_URI=https://app.example.com

# Your deployed backend (aws/api) and media storage.
VITE_API_GATEWAY_URL=
VITE_S3_BUCKET=
VITE_CLOUDFRONT_URL=

# Where this app is hosted. Used for self-referential links and OAuth callbacks.
APP_URL=http://localhost:3000

# ─── Feature flags (1 = on, absent/0 = off) ──────────────────────────────────
# Settings → Connectors: external integrations (Jira, GitHub, and friends).
VITE_CONNECTORS=1
# Server-side chat: required for connector-aware chat and Jira actions in chat.
VITE_SERVER_CHAT=1
# Server-computed knowledge-graph rendering.
VITE_SERVER_KG_GRAPH=1
VITE_BRAIN_GRAPH=1

# ─── Billing (optional — only if you run a paid tier) ────────────────────────
# Paddle powers Settings → Billing. Omit all of this to run without billing.
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CHECKOUT_URL=
VITE_PADDLE_PRO_MONTHLY_PRICE_ID=
VITE_PADDLE_PRO_YEARLY_PRICE_ID=
VITE_PADDLE_TEAM_MONTHLY_PRICE_ID=
VITE_PADDLE_TEAM_YEARLY_PRICE_ID=
VITE_PADDLE_CUSTOMER_PORTAL_URL=
VITE_PADDLE_CLIENT_TOKEN=
VITE_WEBSITE_CHECKOUT_URL=

# ─── Deprecated ──────────────────────────────────────────────────────────────
# Supabase was replaced by the AWS backend. Left here only so older branches
# still build; no need to set either value.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
