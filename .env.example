# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL= 
VITE_SUPABASE_ANON_KEY=

# OpenRouter API Key (for Knowledge Graph extraction)
VITE_OPENROUTER_API_KEY=


# Deepgram API Key (for real-time transcription mode)
# Used by the Rust lumina_server backend
DEEPGRAM_API_KEY=

# Turbopuffer Vector DB API Key (for hybrid RAG retrieval)
VITE_TURBOPUFFER_API_KEY=

#
# ─── Cognito + Google (fix Google 400 redirect_uri_mismatch) ────────────────
# In Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0
# Web client (same Client ID/secret as in Cognito → User pool → Sign-in → Google):
# “Authorized redirect URIs” — add every Cognito Hosted UI hostname you ship in
# VITE_COGNITO_AUTH_ORIGIN (Google shows that host on “Sign in to continue to…”).
#
# Custom domain example (recommended for branding):
#   https://auth.wisprnote.com/oauth2/idpresponse
#
# Regional default domain (fallback during DNS setup):
#   https://wisprnote-auth.auth.us-east-1.amazoncognito.com/oauth2/idpresponse
#
# App callback URLs (localhost, Vercel, wisprnote://) belong in Cognito → App client
# → Hosted UI only — not in Google’s redirect URIs for federation.
#
# Optional: if your User pool’s Google IdP name is not exactly `Google`, set it here so
# “Continue with Google” skips Cognito’s hosted sign-in page and goes straight to Google.
# VITE_COGNITO_IDENTITY_PROVIDER=Google
#
# ─── Cognito redirect_mismatch (production) ───────────────────────────────────
# Hosted UI sends redirect_uri; it must match “Allowed callback URLs” character-for-character.
# On Vercel set (no trailing slash, same host users use www vs apex):
#   VITE_WEB_OAUTH_REDIRECT_URI=https://www.wisprnote.com
# Cognito console → App integration → App client → Hosted UI → add the EXACT same callback.
# Omit locally so dev uses window.location.origin (http://localhost:3000).
# VITE_WEB_OAUTH_REDIRECT_URI=

# AWS API Gateway base URL (used by Vercel edge functions for OG/share preview)
VITE_API_GATEWAY_URL=

# ─── Paddle Billing (payment gateway) ────────────────────────────────────────
# Powers Settings → Billing. Checkout opens in the system browser, so the
# required values are a default payment-link URL plus a price ID per plan/cycle.
# Create these in your Paddle dashboard once your seller account is approved.
#
# 'sandbox' while testing, 'production' once live.
VITE_PADDLE_ENV=sandbox
#
# Default payment-link URL: Paddle → Checkout settings → Default payment link.
#   Sandbox default looks like: https://sandbox-pay.paddle.io
#   Production custom domain (recommended): https://pay.wisprnote.com
VITE_PADDLE_CHECKOUT_URL=
#
# Price IDs (Paddle → Catalog → Products → Prices), one per plan + billing cycle.
VITE_PADDLE_PRO_MONTHLY_PRICE_ID=
VITE_PADDLE_PRO_YEARLY_PRICE_ID=
VITE_PADDLE_TEAM_MONTHLY_PRICE_ID=
VITE_PADDLE_TEAM_YEARLY_PRICE_ID=
#
# Customer portal URL for managing/cancelling an existing subscription.
VITE_PADDLE_CUSTOMER_PORTAL_URL=
#
# Client-side token (Paddle → Developer tools → Authentication). Not used by the
# browser-checkout flow today, but kept so the app can switch to the inline
# Paddle.js overlay later without re-plumbing config.
VITE_PADDLE_CLIENT_TOKEN=
