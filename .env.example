# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL= 
VITE_SUPABASE_ANON_KEY=

# OpenRouter API Key (for Knowledge Graph extraction)
VITE_OPENROUTER_API_KEY=


# Deepgram API Key (for real-time transcription mode)
# Used by the Rust lumina_server backend
DEEPGRAM_API_KEY=

# Turbopuffer Vector DB API Key (for hybrid RAG retrieval)
VITE_TURBOPUFFER_API_KEY=

#
# ─── Cognito + Google (fix Google 400 redirect_uri_mismatch) ────────────────
# In Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0
# Web client (same Client ID/secret as in Cognito → User pool → Sign-in → Google):
# “Authorized redirect URIs” — add every Cognito Hosted UI hostname you ship in
# VITE_COGNITO_AUTH_ORIGIN (Google shows that host on “Sign in to continue to…”).
#
# Custom domain example (recommended for branding):
#   https://auth.wisprnote.com/oauth2/idpresponse
#
# Regional default domain (fallback during DNS setup):
#   https://wisprnote-auth.auth.us-east-1.amazoncognito.com/oauth2/idpresponse
#
# App callback URLs (localhost, Vercel, wisprnote://) belong in Cognito → App client
# → Hosted UI only — not in Google’s redirect URIs for federation.
#
# ─── Cognito redirect_mismatch (production) ───────────────────────────────────
# Hosted UI sends redirect_uri; it must match “Allowed callback URLs” character-for-character.
# On Vercel set (no trailing slash, same host users use www vs apex):
#   VITE_WEB_OAUTH_REDIRECT_URI=https://www.wisprnote.com
# Cognito console → App integration → App client → Hosted UI → add the EXACT same callback.
# Omit locally so dev uses window.location.origin (http://localhost:3000).
# VITE_WEB_OAUTH_REDIRECT_URI=
