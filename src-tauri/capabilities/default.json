{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    "shell:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.turbopuffer.com/**" },
        { "url": "https://*.supabase.co/**" }
      ]
    }
  ]
}
